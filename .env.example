# Copy this file's variable NAMES into Netlify's dashboard under
# Site settings -> Environment variables. Never commit real values —
# this file only documents what is required, with no secrets in it.

# --- Cloudflare Turnstile (https://dash.cloudflare.com/?to=/:account/turnstile) ---
# Public site key — safe to expose client-side, already hardcoded in index.html
# (search for "YOUR_TURNSTILE_SITE_KEY" and replace it with the real value).
TURNSTILE_SITE_KEY=

# Secret key — server-side only, used in netlify/functions/contact.js.
TURNSTILE_SECRET_KEY=

# Optional: only needed if you set a matching "action" on the widget.
TURNSTILE_ACTION=

# --- Resend (https://resend.com) — email delivery ---
# API key — server-side only.
RESEND_API_KEY=

# The address that receives contact-form messages. Server-side only —
# never exposed in HTML, JS, or the client bundle.
CONTACT_TO_EMAIL=

# Must be a sender address/domain verified in your Resend account.
# Defaults to onboarding@resend.dev if left unset (works for testing,
# not recommended for production).
CONTACT_FROM_EMAIL=

# --- Site identity, used for same-origin / hostname checks ---
# e.g. https://www.example.com (no trailing slash)
SITE_URL=

# e.g. www.example.com
SITE_HOSTNAME=

# --- Optional: persistent rate limiting (Upstash Redis free tier) ---
# See README.md "Rate limiting" — without these two set, rate limiting
# in netlify/functions/contact.js is a documented no-op.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
